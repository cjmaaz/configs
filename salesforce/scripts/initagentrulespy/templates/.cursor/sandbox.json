{
  "type": "workspace_readwrite",
  "additionalReadwritePaths": [
    "{{HOME_PATH}}/.sfdx",
    "{{HOME_PATH}}/.sf",
    "{{HOME_PATH}}/.config/sf",
    "{{HOME_PATH}}/.cache",
    "{{WORKSPACE_PATH}}/.sfdx",
    "{{WORKSPACE_PATH}}/.sf",
    "{{WORKSPACE_PATH}}/.config/sf",
    "{{WORKSPACE_PATH}}/.cache"
  ],
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "*.my.salesforce.com",
      "*.salesforce.com",
      "*.force.com",
      "*.sforce.com",
      "*.cloudforce.com",
      "login.salesforce.com",
      "test.salesforce.com"
    ]
  }
}
